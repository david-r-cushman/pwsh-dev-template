{
    "name": "PowerShell Infrastructure Lab",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // MOUNTS REMOVED: No connection to your Windows host .copilot folder.
    "features": {
        // GITHUB-CLI REMOVED: Minimizes potential for identity theft via token storage.
        "ghcr.io/devcontainers/features/common-utils:1": {
            "configureZshAsDefaultShell": false
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.PowerShell",
                "ms-vscode.editorconfig",
                "ms-azuretools.vscode-docker",
                "ms-vscode.azurecli",
                "ionutvmi.path-autocomplete",
                "eamodio.gitlens"
                // GITHUB EXTENSIONS REMOVED: Copilot and Pull Requests purged.
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "pwsh"
            }
        }
    },
    // Note: Kept as root for now to ensure your existing scripts run,
    // but the 'isolation' is restored because the host bridge is gone.
    "remoteUser": "root"
}
