{
    "name": "PowerShell Infrastructure Lab",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.PowerShell",
                "ms-vscode.editorconfig",
                "ms-azuretools.vscode-docker",
                "GitHub.vscode-pull-request-github",
                "GitHub.copilot-chat",
                "ms-vscode.azurecli",
                "ionutvmi.path-autocomplete",
                "eamodio.gitlens"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "pwsh"
            }
        }
    },
    "remoteUser": "root",
    "postCreateCommand": "gh extension list | grep -q 'gh-copilot' || gh extension install github/gh-copilot --force"
}
