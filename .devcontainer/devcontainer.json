{
    "name": "PowerShell Infrastructure Lab",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.PowerShell",
                "GitHub.vscode-pull-request-github",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "ms-vscode.azurecli",
                "ionutvmi.path-autocomplete",
                "eamodio.gitlens"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "pwsh"
            }
        }
    },
    "remoteUser": "root"
}
